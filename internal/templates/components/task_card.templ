package components

import (
	"github.com/sgaunet/runrun/internal/templates"
)

// statusTag returns the Bulma colour modifier matching a task status.
func statusTag(status string) string {
	switch status {
	case "success":
		return "is-success"
	case "failed":
		return "is-danger"
	case "running":
		return "is-info"
	case "queued":
		return "is-warning"
	case "pending":
		return "is-warning is-light"
	default:
		return "is-light"
	}
}

templ statusIcon(status string) {
	switch status {
		case "success":
			<svg class="runrun-icon has-text-success" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-success"></use>
			</svg>
		case "failed":
			<svg class="runrun-icon has-text-danger" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-failed"></use>
			</svg>
		case "running":
			<svg class="runrun-icon has-text-info" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-running"></use>
			</svg>
		case "queued":
			<svg class="runrun-icon has-text-warning" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-queued"></use>
			</svg>
		case "pending":
			<svg class="runrun-icon has-text-warning" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-pending"></use>
			</svg>
		default:
			<svg class="runrun-icon has-text-grey-light" aria-hidden="true">
				<use href="/static/icons/sprite.svg#status-idle"></use>
			</svg>
	}
}

templ TaskCard(task templates.TaskCard) {
	<div class="column is-half-tablet is-one-third-desktop">
		<article class="card" data-task-card data-task-name={ task.Name }>
			<header class="card-header is-shadowless">
				<div class="card-header-title is-flex is-justify-content-space-between">
					<span class="task-title runrun-row">
						@statusIcon(task.Status)
						<span>{ task.Name }</span>
					</span>
					<span class={ "tag", "status-badge", "is-medium", "status-" + task.Status, statusTag(task.Status) }>
						{ task.Status }
					</span>
				</div>
			</header>
			<div class="card-content">
				<p class="task-description has-text-grey-dark">{ task.Description }</p>
				if len(task.Tags) > 0 {
					<div class="task-tags tags mt-3">
						for _, tag := range task.Tags {
							<span class="tag is-info is-light">{ tag }</span>
						}
					</div>
				}
				if task.LastRun != nil || task.Duration != "" {
					<div class="task-meta has-text-grey is-size-7 mt-3">
						if task.LastRun != nil {
							<div class="runrun-row--small">
								<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#status-running"></use></svg>
								<span>{ task.LastRun.Format("Jan 02, 2006 15:04:05") }</span>
							</div>
						}
						if task.Duration != "" {
							<div class="runrun-row--small mt-1">
								<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#refresh"></use></svg>
								<span>{ task.Duration }</span>
							</div>
						}
					</div>
				}
				<div
					id={ "error-" + task.Name }
					class="notification is-danger is-light mt-3 is-hidden"
				></div>
			</div>
			<footer class="card-footer">
				<a href={ templ.URL("/tasks/" + task.Name) } class="card-footer-item button is-text">
					<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#view"></use></svg>
					<span class="ml-1">View</span>
				</a>
				<button
					type="button"
					class="card-footer-item button is-primary is-light has-text-primary"
					data-action="run-task"
					data-task-name={ task.Name }
				>
					<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#run"></use></svg>
					<span class="ml-1">Run</span>
				</button>
			</footer>
		</article>
	</div>
}
