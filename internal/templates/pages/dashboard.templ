package pages

import (
	"fmt"
	"github.com/sgaunet/runrun/internal/templates"
	"github.com/sgaunet/runrun/internal/templates/components"
	"github.com/sgaunet/runrun/internal/templates/layouts"
)

templ Dashboard(data DashboardPageData) {
	@layouts.Base(data.BaseData, dashboardContent(data))
}

// statTile renders one stat cell on the dashboard stats row.
templ statTile(label, id, value, modifier string) {
	<div class="level-item has-text-centered">
		<div>
			<p class={ "heading", modifier }>{ label }</p>
			<p id={ id } class={ "title is-4", modifier }>{ value }</p>
		</div>
	</div>
}

templ dashboardContent(data DashboardPageData) {
	<section class="section pt-4">
		<div class="container is-fluid">
			<div class="mb-5">
				<h2 class="title is-3">Tasks Dashboard</h2>
				<p class="subtitle is-6 has-text-grey">Manage and execute your configured tasks</p>
			</div>

			<!-- Stats row -->
			<nav class="level box mb-5">
				@statTile("Total",      "stat-total",      fmt.Sprint(data.Stats.TotalTasks),      "")
				@statTile("Running",    "stat-running",    fmt.Sprint(data.Stats.RunningTasks),    "has-text-info")
				@statTile("Success",    "stat-success",    fmt.Sprint(data.Stats.SuccessTasks),    "has-text-success")
				@statTile("Failed",     "stat-failed",     fmt.Sprint(data.Stats.FailedTasks),     "has-text-danger")
				@statTile("Idle",       "stat-idle",       fmt.Sprint(data.Stats.IdleTasks),       "has-text-grey")
				@statTile("Executions", "stat-executions", fmt.Sprint(data.Stats.TotalExecutions), "has-text-link")
			</nav>

			<!-- Filter bar -->
			if len(data.Tasks) > 0 {
				<div class="box">
					<div class="field is-grouped is-grouped-multiline">
						<div class="control is-expanded">
							<label for="searchInput" class="label is-size-7">Search tasks</label>
							<div class="control has-icons-left">
								<input
									type="text"
									id="searchInput"
									class="input"
									placeholder="Search by name or description..."
								/>
								<span class="icon is-left">
									<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#search"></use></svg>
								</span>
							</div>
						</div>
						<div class="control">
							<label for="statusFilter" class="label is-size-7">Status</label>
							<div class="select">
								<select id="statusFilter">
									<option value="all">All status</option>
									<option value="idle">Idle</option>
									<option value="running">Running</option>
									<option value="success">Success</option>
									<option value="failed">Failed</option>
									<option value="queued">Queued</option>
								</select>
							</div>
						</div>
						<div class="control">
							<label for="tagFilter" class="label is-size-7">Tag</label>
							<div class="select">
								<select id="tagFilter">
									<option value="all">All tags</option>
								</select>
							</div>
						</div>
						<div class="control is-align-self-flex-end">
							<button class="button is-light" data-action="clear-filters" type="button">
								<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#x"></use></svg>
								<span class="ml-1">Clear</span>
							</button>
						</div>
					</div>
					<p class="help mt-2" id="resultsCount">Showing all { fmt.Sprint(len(data.Tasks)) } tasks</p>
				</div>
			}

			<!-- Task cards -->
			if len(data.Tasks) > 0 {
				<div class="columns is-multiline mt-3" id="taskGrid">
					for _, task := range data.Tasks {
						@components.TaskCard(task)
					}
				</div>
				<div id="noResults" class="runrun-empty-state is-hidden">
					<div class="runrun-empty-state__icon">
						<svg class="runrun-icon runrun-icon--lg" aria-hidden="true">
							<use href="/static/icons/sprite.svg#search"></use>
						</svg>
					</div>
					<p class="runrun-empty-state__title">No tasks found</p>
					<p class="runrun-empty-state__help">Try adjusting your search or filters.</p>
					<button class="button is-light is-small" data-action="clear-filters" type="button">Clear filters</button>
				</div>
			} else {
				<div class="runrun-empty-state">
					<div class="runrun-empty-state__icon">
						<svg class="runrun-icon runrun-icon--lg" aria-hidden="true">
							<use href="/static/icons/sprite.svg#status-queued"></use>
						</svg>
					</div>
					<p class="runrun-empty-state__title">No tasks configured</p>
					<p class="runrun-empty-state__help">Add tasks to your configuration file to get started.</p>
				</div>
			}
		</div>
	</section>
	@dashboardScript(data.BaseData.CSRFToken)
}

// dashboardScript wires search/filter/auto-refresh behaviour. Emitted
// under the per-request CSP nonce thanks to templ.WithNonce in the
// renderCtx helper.
script dashboardScript(csrfToken string) {
	(function () {
		'use strict';
		const CSRF_TOKEN = csrfToken;
		let autoRefreshInterval = null;
		const autoRefreshEnabled = true;

		document.addEventListener('DOMContentLoaded', function () {
			populateTagFilter();
			restoreFiltersFromURL();
			attachFilterListeners();
			startAutoRefresh();
		});

		function populateTagFilter() {
			const tagFilter = document.getElementById('tagFilter');
			if (!tagFilter) return;
			const seen = new Set();
			document.querySelectorAll('[data-task-card] .tag').forEach(function (t) {
				const v = t.textContent.trim();
				if (v && !seen.has(v) && !/^(success|failed|running|queued|idle|pending)$/i.test(v)) {
					seen.add(v);
				}
			});
			Array.from(seen).sort().forEach(function (tag) {
				const opt = document.createElement('option');
				opt.value = tag;
				opt.textContent = tag;
				tagFilter.appendChild(opt);
			});
		}

		function restoreFiltersFromURL() {
			const params = new URLSearchParams(window.location.search);
			['search', 'status', 'tag'].forEach(function (key) {
				const value = params.get(key);
				if (value === null) return;
				const idMap = { search: 'searchInput', status: 'statusFilter', tag: 'tagFilter' };
				const el = document.getElementById(idMap[key]);
				if (el) el.value = value;
			});
			if (params.has('search') || params.has('status') || params.has('tag')) filterTasks();
		}

		function attachFilterListeners() {
			const s = document.getElementById('searchInput');
			const st = document.getElementById('statusFilter');
			const tg = document.getElementById('tagFilter');
			let debounceTimer;
			if (s) s.addEventListener('input', function () {
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(filterTasks, 200);
			});
			if (st) st.addEventListener('change', filterTasks);
			if (tg) tg.addEventListener('change', filterTasks);
		}

		function filterTasks() {
			const search = (document.getElementById('searchInput') || {}).value || '';
			const statusVal = (document.getElementById('statusFilter') || {}).value || 'all';
			const tagVal = (document.getElementById('tagFilter') || {}).value || 'all';
			const q = search.trim().toLowerCase();
			const cards = document.querySelectorAll('[data-task-card]');
			const grid = document.getElementById('taskGrid');
			const noResults = document.getElementById('noResults');
			let visible = 0;
			cards.forEach(function (card) {
				const name = (card.getAttribute('data-task-name') || '').toLowerCase();
				const desc = (card.querySelector('.task-description') || { textContent: '' }).textContent.toLowerCase();
				const status = (card.querySelector('.status-badge') || { textContent: '' }).textContent.trim().toLowerCase();
				const tags = Array.from(card.querySelectorAll('.tag')).map(function (t) { return t.textContent.trim(); });
				const matchSearch = q === '' || name.includes(q) || desc.includes(q);
				const matchStatus = statusVal === 'all' || status === statusVal;
				const matchTag = tagVal === 'all' || tags.indexOf(tagVal) !== -1;
				const show = matchSearch && matchStatus && matchTag;
				card.classList.toggle('is-hidden', !show);
				if (show) visible++;
			});
			const total = cards.length;
			const counter = document.getElementById('resultsCount');
			if (counter) {
				counter.textContent = visible === total
					? 'Showing all ' + total + ' tasks'
					: 'Showing ' + visible + ' of ' + total + ' tasks';
			}
			if (grid && noResults) {
				if (visible === 0 && total > 0) {
					grid.classList.add('is-hidden');
					noResults.classList.remove('is-hidden');
				} else {
					grid.classList.remove('is-hidden');
					noResults.classList.add('is-hidden');
				}
			}
			updateURLParams(search, statusVal, tagVal);
		}

		function updateURLParams(search, status, tag) {
			const params = new URLSearchParams();
			if (search) params.set('search', search);
			if (status && status !== 'all') params.set('status', status);
			if (tag && tag !== 'all') params.set('tag', tag);
			const newURL = params.toString()
				? window.location.pathname + '?' + params.toString()
				: window.location.pathname;
			window.history.replaceState({}, '', newURL);
		}

		// Expose for main.js clear-filters delegate
		window.filterTasks = filterTasks;

		function startAutoRefresh() {
			if (autoRefreshInterval) clearInterval(autoRefreshInterval);
			autoRefreshInterval = setInterval(updateDashboardStatus, 5000);
		}

		function updateDashboardStatus() {
			if (!autoRefreshEnabled) return;
			fetch('/api/status', { credentials: 'same-origin' })
				.then(function (res) { return res.json(); })
				.then(function (data) {
					if (data.stats) updateStats(data.stats);
				})
				.catch(function (err) { console.error('Status refresh failed:', err); });
		}

		function updateStats(stats) {
			const map = {
				'stat-total': stats.total,
				'stat-running': stats.running,
				'stat-success': stats.success,
				'stat-failed': stats.failed,
				'stat-idle': stats.idle,
				'stat-executions': stats.executions,
			};
			Object.keys(map).forEach(function (id) {
				const el = document.getElementById(id);
				if (el) el.textContent = map[id] != null ? map[id] : 0;
			});
		}
	}());
}

// DashboardPageData contains data for the dashboard page
type DashboardPageData struct {
	BaseData layouts.BaseData
	Tasks    []templates.TaskCard
	Stats    templates.DashboardStats
}
