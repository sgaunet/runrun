package pages

import (
	"github.com/sgaunet/runrun/internal/templates/layouts"
)

templ Logs(data LogsPageData) {
	@layouts.Base(data.BaseData, logsContent(data))
}

templ logsContent(data LogsPageData) {
	<section class="section pt-4">
		<div class="container is-fluid">
			<div class="mb-4">
				<a href={ templ.URL("/tasks/" + data.TaskName) } class="has-text-link runrun-row--tight">
					<svg class="runrun-icon runrun-icon--flip" aria-hidden="true">
						<use href="/static/icons/sprite.svg#chevron-right"></use>
					</svg>
					<span>Back to Task</span>
				</a>
			</div>

			<div class="level mb-4">
				<div class="level-left">
					<div>
						<h2 class="title is-4">Execution Logs</h2>
						<div class="tags has-addons mt-2">
							<span class="tag is-dark">Execution</span>
							<span class="tag"><code>{ data.ExecutionID }</code></span>
						</div>
					</div>
				</div>
				<div class="level-right">
					<div class="tags has-addons">
						<span class="tag is-dark">Task</span>
						<span class="tag is-info">{ data.TaskName }</span>
					</div>
					<div class="tags has-addons ml-3">
						<span class="tag is-dark">Status</span>
						<span class={ "tag", "status-badge", "status-" + data.Status, statusTagInline(data.Status) }>
							{ data.Status }
						</span>
					</div>
				</div>
			</div>

			<div id="logViewerContainer"></div>
			<div id="wsBanner" class="notification is-warning is-light runrun-ws-banner is-hidden">
				<strong>Connection lost.</strong>
				The log stream was interrupted; switched to polling.
				<button class="button is-warning is-small ml-3" type="button" data-action="ws-reconnect">Reconnect now</button>
			</div>
		</div>
	</section>
	<script type="module" src={ "/static/js/vendor/ansi_up_loader.js?v=" + data.BaseData.AssetVersion } nonce={ data.BaseData.CSPNonce }></script>
	@logsScript(data.ExecutionID, data.Status)
}

// logsScript wires the LogViewer to the WebSocket / pagination endpoints.
// Emitted under the per-request CSP nonce via templ.WithNonce.
script logsScript(executionID string, executionStatus string) {
	(function () {
		'use strict';
		const EXECUTION_ID = executionID;
		const EXECUTION_STATUS = executionStatus;

		function initLogViewer() {
			if (typeof window.AnsiUp === 'undefined' || !window.RunRun || !window.RunRun.LogViewer) {
				setTimeout(initLogViewer, 50);
				return;
			}

			const logViewer = new window.RunRun.LogViewer('logViewerContainer', {
				autoScroll: true,
				showLineNumbers: true,
				showTimestamps: true,
			});

			const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
			const wsBaseUrl = protocol + '//' + window.location.host + '/logs/ws/' + EXECUTION_ID;
			let ws = null;
			let reconnectAttempts = 0;
			const maxReconnectAttempts = 5;
			let pollInterval = null;

			function buildWsUrl() { return wsBaseUrl; }

			function showWsBanner() {
				const b = document.getElementById('wsBanner');
				if (b) b.classList.remove('is-hidden');
			}
			function hideWsBanner() {
				const b = document.getElementById('wsBanner');
				if (b) b.classList.add('is-hidden');
			}

			function connectWebSocket() {
				ws = new WebSocket(buildWsUrl());
				ws.onopen = function () {
					reconnectAttempts = 0;
					hideWsBanner();
				};
				ws.onmessage = function (event) {
					try {
						const message = JSON.parse(event.data);
						if (message.type === 'metadata' && message.data) {
							if (message.data.total_lines != null) {
								logViewer.setTotalLines(message.data.total_lines);
							}
						} else if (message.type === 'log' && message.data) {
							logViewer.addLine(message.data.line, {
								timestamp: new Date(message.data.timestamp),
								level: message.data.level,
							});
						} else if (message.type === 'log_batch' && Array.isArray(message.data)) {
							for (const entry of message.data) {
								logViewer.addLine(entry.line, {
									timestamp: new Date(entry.timestamp),
									level: entry.level,
								});
							}
						} else if (message.type === 'complete' && message.data) {
							const statusBadge = document.querySelector('.status-badge');
							if (statusBadge) {
								const oldStatus = statusBadge.textContent.trim();
								const newStatus = message.data.status || 'unknown';
								statusBadge.textContent = newStatus;
								statusBadge.className = statusBadge.className.replace('status-' + oldStatus, 'status-' + newStatus);
							}
							reconnectAttempts = maxReconnectAttempts;
							logViewer.addLine('[Execution completed: ' + message.data.status + ']', {
								timestamp: new Date(),
								level: 'info',
							});
						}
					} catch (e) {
						console.error('Failed to parse WebSocket message:', e);
					}
				};
				ws.onerror = function (error) { console.error('WebSocket error:', error); };
				ws.onclose = function () {
					if (reconnectAttempts < maxReconnectAttempts) {
						reconnectAttempts++;
						const delay = Math.min(1000 * Math.pow(2, reconnectAttempts), 30000);
						showWsBanner();
						setTimeout(connectWebSocket, delay);
					} else {
						showWsBanner();
						startPolling();
					}
				};
			}

			function startPolling() {
				if (pollInterval) return;
				pollInterval = setInterval(function () {
					fetch('/logs/' + EXECUTION_ID + '/poll?lines=100', { credentials: 'same-origin' })
						.then(function (res) { return res.json(); })
						.then(function (data) {
							if (data.logs && data.logs.length > 0) {
								logViewer.clear();
								logViewer.addLines(data.logs);
							}
						})
						.catch(function (err) { console.error('Polling error:', err); });
				}, 3000);
			}

			const isCompleted =
				EXECUTION_STATUS === 'success' ||
				EXECUTION_STATUS === 'failed' ||
				EXECUTION_STATUS === 'cancelled';

			if (isCompleted) {
				logViewer.enablePagination(EXECUTION_ID);
			} else {
				connectWebSocket();
			}

			// Manual reconnect button (data-action="ws-reconnect").
			document.addEventListener('click', function (e) {
				const t = e.target.closest('[data-action="ws-reconnect"]');
				if (!t) return;
				e.preventDefault();
				if (ws) try { ws.close(); } catch (_) { /* ignore */ }
				if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
				reconnectAttempts = 0;
				hideWsBanner();
				connectWebSocket();
			});

			window.addEventListener('beforeunload', function () {
				if (ws) ws.close();
				if (pollInterval) clearInterval(pollInterval);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initLogViewer);
		} else {
			initLogViewer();
		}
	}());
}

// LogsPageData contains data for the logs page
type LogsPageData struct {
	BaseData    layouts.BaseData
	ExecutionID string
	TaskName    string
	Status      string
}
