package pages

import (
	"github.com/sgaunet/runrun/internal/templates/layouts"
)

templ Logs(data LogsPageData) {
	@layouts.Base(data.BaseData, logsContent(data))
}

templ logsContent(data LogsPageData) {
	<div class="py-6">
		<div class="mb-6">
			<a href={ templ.URL("/tasks/" + data.TaskName) } class="text-primary-600 hover:text-primary-700 flex items-center gap-1">
				<span>&larr;</span>
				<span>Back to Task</span>
			</a>
		</div>
		<div class="mb-6">
			<h2 class="text-3xl font-bold text-gray-900 mb-2">Execution Logs</h2>
			<div class="flex flex-wrap gap-4 text-sm text-gray-600">
				<div>
					<span class="font-semibold">Execution ID:</span>
					<code class="ml-2 bg-gray-100 px-2 py-1 rounded">{ data.ExecutionID }</code>
				</div>
				<div>
					<span class="font-semibold">Task:</span>
					<span class="ml-2">{ data.TaskName }</span>
				</div>
				<div>
					<span class="font-semibold">Status:</span>
					<span class={ "ml-2 status-badge", "status-" + data.Status }>{ data.Status }</span>
				</div>
			</div>
		</div>
		<div id="logViewerContainer"></div>
	</div>
	<script type="module" src="/static/js/vendor/ansi_up_loader.js"></script>
	<script src="/static/js/log-viewer.js"></script>
	@logsScript(data.ExecutionID, data.Status)
}

// logsScript generates the logs viewer JavaScript with execution ID
script logsScript(executionID string, executionStatus string) {
	const EXECUTION_ID = executionID;
	const EXECUTION_STATUS = executionStatus;

	// Wait for AnsiUp to be loaded by the module before initializing
	function initLogViewer() {
		if (typeof window.AnsiUp === 'undefined') {
			// AnsiUp not loaded yet, wait and retry
			setTimeout(initLogViewer, 50);
			return;
		}

		// Initialize log viewer
		const logViewer = new LogViewer('logViewerContainer', {
			autoScroll: true,
			showLineNumbers: true,
			showTimestamps: true
		});

		// Connect to WebSocket for real-time logs
		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const wsBaseUrl = `${protocol}//${window.location.host}/logs/ws/${EXECUTION_ID}`;
		let serverLevelFilter = ''; // Server-side level filter (query param)

		function buildWsUrl() {
			if (serverLevelFilter && serverLevelFilter !== 'all') {
				return `${wsBaseUrl}?level=${encodeURIComponent(serverLevelFilter)}`;
			}
			return wsBaseUrl;
		}

		let ws = null;
		let reconnectAttempts = 0;
		const maxReconnectAttempts = 5;

		function connectWebSocket() {
			ws = new WebSocket(buildWsUrl());

			ws.onopen = () => {
				console.log('WebSocket connected');
				reconnectAttempts = 0;
			};

			ws.onmessage = (event) => {
				try {
					const message = JSON.parse(event.data);
					if (message.type === 'metadata' && message.data) {
						if (message.data.total_lines != null) {
							logViewer.setTotalLines(message.data.total_lines);
						}
					} else if (message.type === 'log' && message.data) {
						logViewer.addLine(message.data.line, {
							timestamp: new Date(message.data.timestamp),
							level: message.data.level
						});
					} else if (message.type === 'log_batch' && Array.isArray(message.data)) {
						for (const entry of message.data) {
							logViewer.addLine(entry.line, {
								timestamp: new Date(entry.timestamp),
								level: entry.level
							});
						}
					} else if (message.type === 'complete' && message.data) {
						// Update status badge on the page
						const statusBadge = document.querySelector('.status-badge');
						if (statusBadge) {
							const oldStatus = statusBadge.textContent.trim();
							const newStatus = message.data.status || 'unknown';
							statusBadge.textContent = newStatus;
							statusBadge.className = statusBadge.className.replace('status-' + oldStatus, 'status-' + newStatus);
						}
						// Stop reconnect attempts
						reconnectAttempts = maxReconnectAttempts;
						logViewer.addLine(`[Execution completed: ${message.data.status}]`, {
							timestamp: new Date(),
							level: 'info'
						});
					}
				} catch (e) {
					console.error('Failed to parse WebSocket message:', e);
				}
			};

			ws.onerror = (error) => {
				console.error('WebSocket error:', error);
			};

			ws.onclose = () => {
				console.log('WebSocket closed');
				if (reconnectAttempts < maxReconnectAttempts) {
					reconnectAttempts++;
					const delay = Math.min(1000 * Math.pow(2, reconnectAttempts), 30000);
					console.log(`Reconnecting in ${delay}ms (attempt ${reconnectAttempts}/${maxReconnectAttempts})`);
					setTimeout(connectWebSocket, delay);
				} else {
					console.log('Max reconnect attempts reached, falling back to polling');
					startPolling();
				}
			};
		}

		// HTTP polling fallback
		let pollInterval = null;
		function startPolling() {
			if (pollInterval) return;

			pollInterval = setInterval(() => {
				fetch(`/logs/${EXECUTION_ID}/poll?lines=100`)
					.then(res => res.json())
					.then(data => {
						if (data.logs && data.logs.length > 0) {
							logViewer.clear();
							logViewer.addLines(data.logs);
						}
					})
					.catch(err => console.error('Polling error:', err));
			}, 3000);
		}

		// Determine if execution is completed (use pagination) or running (use WebSocket)
		const isCompleted = EXECUTION_STATUS === 'success' || EXECUTION_STATUS === 'failed' || EXECUTION_STATUS === 'cancelled';

		if (isCompleted) {
			logViewer.enablePagination(EXECUTION_ID);
		} else {
			connectWebSocket();
		}

		// Cleanup on page unload
		window.addEventListener('beforeunload', () => {
			if (ws) ws.close();
			if (pollInterval) clearInterval(pollInterval);
		});
	}

	// Start initialization when DOM is ready
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initLogViewer);
	} else {
		initLogViewer();
	}
}

// LogsPageData contains data for the logs page
type LogsPageData struct {
	BaseData    layouts.BaseData
	ExecutionID string
	TaskName    string
	Status      string
}
