package pages

import (
	"github.com/sgaunet/runrun/internal/templates"
	"github.com/sgaunet/runrun/internal/templates/layouts"
)

templ TaskDetail(data TaskDetailPageData) {
	@layouts.Base(data.BaseData, taskDetailContent(data))
}

templ taskDetailContent(data TaskDetailPageData) {
	<section class="section pt-4">
		<div class="container is-fluid">
			<div class="mb-4">
				<a href="/" class="has-text-link runrun-row--tight">
					<svg class="runrun-icon runrun-icon--flip" aria-hidden="true">
						<use href="/static/icons/sprite.svg#chevron-right"></use>
					</svg>
					<span>Back to Dashboard</span>
				</a>
			</div>

			<div class="level mb-5">
				<div class="level-left">
					<div>
						<h2 class="title is-3" data-task-name={ data.TaskName }>{ data.TaskName }</h2>
						<p class="subtitle is-6 has-text-grey">{ data.Description }</p>
						if len(data.Tags) > 0 {
							<div class="tags mt-2">
								for _, tag := range data.Tags {
									<span class="tag is-info is-light">{ tag }</span>
								}
							</div>
						}
					</div>
				</div>
				<div class="level-right">
					<div>
						<button
							type="button"
							class="button is-primary"
							data-action="run-task"
							data-task-name={ data.TaskName }
							id="runTaskBtn"
						>
							<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#run"></use></svg>
							<span class="ml-1">Run Task</span>
						</button>
						<div id="task-message" class="notification is-light is-hidden mt-2"></div>
					</div>
				</div>
			</div>

			<section class="box">
				<h3 class="title is-5">Execution History</h3>
				if len(data.Executions) > 0 {
					<div class="table-container">
						<table class="table is-fullwidth is-striped is-hoverable" data-execution-history>
							<thead>
								<tr>
									<th>Execution ID</th>
									<th>Status</th>
									<th class="is-hidden-mobile">Started At</th>
									<th class="is-hidden-touch">Duration</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, exec := range data.Executions {
									<tr>
										<td><code>{ exec.ID[:8] }</code></td>
										<td>
											<span class={ "tag", "status-badge", "status-" + exec.Status, statusTagInline(exec.Status) }>
												{ exec.Status }
											</span>
										</td>
										<td class="is-hidden-mobile is-size-7 has-text-grey">{ exec.StartedAt.Format("2006-01-02 15:04") }</td>
										<td class="is-hidden-touch is-size-7 has-text-grey">{ exec.Duration }</td>
										<td>
											<a href={ templ.URL("/logs/" + exec.ID) } class="button is-small is-light">
												<svg class="runrun-icon" aria-hidden="true"><use href="/static/icons/sprite.svg#view"></use></svg>
												<span class="ml-1">Logs</span>
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<div class="runrun-empty-state">
						<div class="runrun-empty-state__icon">
							<svg class="runrun-icon runrun-icon--lg" aria-hidden="true"><use href="/static/icons/sprite.svg#status-idle"></use></svg>
						</div>
						<p class="runrun-empty-state__title">No executions yet</p>
						<p class="runrun-empty-state__help">Run the task above to see its execution history here.</p>
					</div>
				}
			</section>
		</div>
	</section>
}

// statusTagInline returns the Bulma colour modifier for a status string,
// scoped to this page (the components package owns the public statusTag
// helper for cards).
func statusTagInline(status string) string {
	switch status {
	case "success":
		return "is-success"
	case "failed":
		return "is-danger"
	case "running":
		return "is-info"
	case "queued":
		return "is-warning"
	default:
		return "is-light"
	}
}

// TaskDetailPageData contains data for the task detail page
type TaskDetailPageData struct {
	BaseData    layouts.BaseData
	TaskName    string
	Description string
	Tags        []string
	Status      string
	Executions  []templates.ExecutionInfo
}
